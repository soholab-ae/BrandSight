# Production Environment Configuration Template
# Copy these variables to your deployment environment (Fly.io secrets)

# Core Node.js settings
NODE_ENV=production
PORT=8080

# Performance optimizations
NPM_CONFIG_UPDATE_NOTIFIER=false
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false

# Disable development features
VITE_NODE_ENV=production

# Memory optimization
NODE_OPTIONS="--max-old-space-size=512"

# Security settings
DISABLE_LOGGING=false
ENABLE_CORS=false

# Database settings (ensure these are set in your Fly.io environment)
# DATABASE_URL=<your-database-url>

# Shopify settings (ensure these are set in your Fly.io environment)
# SHOPIFY_API_KEY=<your-api-key>
# SHOPIFY_API_SECRET=<your-api-secret>
# SHOPIFY_SCOPES=<your-scopes>
# SHOPIFY_APP_URL=<your-app-url>

# Session settings
# SESSION_SECRET=<your-session-secret>

# Cache settings for production
ENABLE_CACHE=true
CACHE_TTL=300

# Request timeout settings
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000