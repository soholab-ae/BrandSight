# BrandSight Environment Variables
# Copy these to your Replit deployment settings

# Database (Already configured by Replit)
# DATABASE_URL=your_neon_database_url
# SESSION_SECRET=your_session_secret

# Shopify Integration (Required)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=read_products,read_orders,read_customers
HOST=https://www.brandsightai.ae

# Authentication Mode (Required for Shopify App)
USE_SHOPIFY_AUTH=true

# Optional
# PORT=5000
# NODE_ENV=production